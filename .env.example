# Example local PostgreSQL connection
# Replace the placeholder with your own local credentials.
DATABASE_URL="postgresql://vienna_dev:YOUR_LOCAL_PASSWORD@localhost:5432/vienna_cuts?schema=public"

# Exact public origin, without a path. Use HTTPS outside local development.
BETTER_AUTH_URL="http://localhost:3000"
# Replace this deliberately invalid placeholder with a cryptographically random
# secret of at least 32 characters. Never commit the real value.
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
